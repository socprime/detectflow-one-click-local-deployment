# ─────────────────────────────────────────────────────────────────────────────
# DetectFlow Demo - Deployment Configuration (.env)
# Sourced by deploy-detectflow-minikube.sh. Edit values here, not in the script.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Minikube cluster (server: 8 CPU / 16 GB RAM / 128 GB disk) ───────────────
# Community defaults. Leave the host OS + Docker at least ~4 GB RAM: a minikube
# limit close to total RAM makes the node thrash and hang. The component limits
# below sum to ~6 GB, leaving room in the 12 GB node for Kubernetes itself and 1-2
# Flink pipelines. On a bigger server raise MINIKUBE_MEMORY and the limits together.
MINIKUBE_CPUS=6
MINIKUBE_MEMORY=12288
MINIKUBE_DISK="100g"
MINIKUBE_DRIVER="docker"
# Container runtime inside the minikube node (how kubelet runs pods) - separate from
#   MINIKUBE_DRIVER (what the node itself runs in). Pinned so it does not depend on the
#   installed minikube version (its implicit default changed docker -> containerd in
#   v1.39.0). Applies only when the cluster is CREATED; an existing cluster keeps its runtime.
MINIKUBE_CONTAINER_RUNTIME="containerd"
NAMESPACE="flink"
FLINK_OPERATOR_NS="flink-operator"

# ─── Operator / add-on versions ───────────────────────────────────────────────
# cert-manager release tag (note the leading "v"); used in the GitHub release URL.
CERT_MANAGER_VERSION="v1.21.1"
# Flink Kubernetes Operator version (no leading "v"); used in the Apache Helm repo URL.
FLINK_OPERATOR_VERSION="1.15.0"

# ─── Network / remote access ──────────────────────────────────────────────────
# SERVER_HOST: the address clients use to reach this server - either an IP
#   (e.g. 10.0.0.5) or an FQDN/hostname (e.g. detectflow-demo-01.corp.example.com). NOT localhost.
#   - For remote Kafka clients it MUST be reachable from those clients, otherwise
#     the broker advertises an unreachable address and external clients fail.
#   - Used for the Kafka advertised listener, printed access URLs, and (with TLS
#     in selfsigned mode) the certificate SAN.
SERVER_HOST="REPLACE_WITH_SERVER_IP_OR_FQDN"
# PF_ADDRESS: bind address for `kubectl port-forward`. 0.0.0.0 = reachable from network.
PF_ADDRESS="0.0.0.0"
# POSTGRES_PF_ADDRESS: bind address for the PostgreSQL forward only. Default 127.0.0.1 =
#   reachable on the server itself; connect from your machine through an SSH tunnel
#   (pgAdmin "SSH Tunnel" tab - see README "PostgreSQL Access (pgAdmin)"). Set 0.0.0.0 to
#   expose it to the network like the other services (it uses the default demo password).
POSTGRES_PF_ADDRESS="127.0.0.1"

# ─── Service ports (host side) ────────────────────────────────────────────────
UI_PORT=4173
API_PORT=8000
KAFKA_UI_PORT=8080
KAFKA_EXTERNAL_PORT=9094
DASHBOARD_PORT=8443
POSTGRES_PORT=5432

# ─── TLS (per-port) ───────────────────────────────────────────────────────────
# ON by default. The UI is effectively HTTPS-only (its image ships a CSP that upgrades
# assets to https), so over plain HTTP it renders a blank page. With TLS on, Traefik
# terminates TLS so the UI/API/Kafka-UI/Dashboard ports serve HTTPS on the same port
# numbers (https://SERVER_HOST:<port>). Kafka broker, PostgreSQL and Logstash stay plaintext.
# selfsigned mode warns in the browser until you import the CA - but the UI loads.
# Set "false" only if you terminate TLS for the UI another way (external LB / ingress).
TLS_ENABLED="true"
# Cert source: "selfsigned" (cert-manager self-signed CA, SAN = SERVER_HOST) |
#              "provided" (your own cert files; SERVER_HOST must be a name the cert covers).
TLS_MODE="selfsigned"
# Traefik Helm chart version (verify: helm search repo traefik/traefik --versions).
TRAEFIK_VERSION="34.1.0"
# provided mode only: paths to your cert + key (PEM). Secrets live in these files, NOT in .env.
TLS_CERT_FILE=""
TLS_KEY_FILE=""

# ─── Pre-built Docker Hub images (public, no login needed) ────────────────────
IMAGE_BACKEND="socprime/detectflow-oss:admin-panel-be-oss.v2.3.3"
IMAGE_UI="socprime/detectflow-oss:admin-panel-ui-oss.v2.3.3"
IMAGE_FLINK="socprime/detectflow-oss:flink-sigma-detector-oss.v2.3.3"
# Job images the backend launches (df-agent / df-correlation).
IMAGE_AGENT="socprime/detectflow-oss:df-agent-oss.v2.3.3"
IMAGE_CORRELATION="socprime/detectflow-oss:df-correlation-oss.v2.3.3"

# ─── DetectFlow Agent (LLM) ───────────────────────────────────────────────────
# LLM config for the agent jobs the backend launches on Flink. Optional: leave the
# defaults if you are not using the LLM features. LLM_API_KEY is injected into a
# Secret (stringData) at apply time and is NEVER committed - set it here in .env only.
LLM_BASE_URL="http://localhost:8000/v1/"
LLM_MODEL="model"
LLM_API_KEY=""
# Tuning (safe defaults).
LLM_CALLS_PER_MINUTE="60"
LLM_MAX_RETRIES="3"
LLM_MAX_TOKENS="2048"
LLM_PROMPT_CHAR_BUDGET="24000"
MAX_CONCURRENT_LLM_REQUESTS="1"
# Self-signed / internal LLM CA (optional; needs backend >= v2.2.0). To make the
# agent trust a self-signed LLM_BASE_URL, set LLM_CA_FILE to a PEM CA bundle path
# (like TLS_CERT_FILE, the file stays out of git). The cert MUST carry a SAN for the
# LLM host/IP (CN-only is rejected). LLM_CA_MOUNT_PATH is the in-container path
# (dir = mount point, filename = Secret key); leave the default unless it collides.
LLM_CA_FILE=""
LLM_CA_MOUNT_PATH="/etc/ssl/agent-ca/ca.pem"
# Verification toggle: "true" (default, secure) or "false" (testing only, skips TLS verify).
LLM_SSL_VERIFY="true"

# ─── PostgreSQL resources + tuning ────────────────────────────────────────────
IMAGE_POSTGRES="postgres:14-alpine"
PG_CPU_REQUEST="250m"
PG_CPU_LIMIT="2"
PG_MEM_REQUEST="512Mi"
PG_MEM_LIMIT="1Gi"
PG_STORAGE="20Gi"
PG_SHARED_BUFFERS="256MB"
PG_EFFECTIVE_CACHE_SIZE="768MB"
PG_MAINTENANCE_WORK_MEM="128MB"
PG_WORK_MEM="8MB"
PG_MAX_CONNECTIONS="100"

# ─── Kafka resources + tuning ─────────────────────────────────────────────────
IMAGE_KAFKA="apache/kafka:4.3.1"
IMAGE_KAFKA_UI="ghcr.io/kafbat/kafka-ui:v1.5.0"
KAFKA_CPU_REQUEST="500m"
KAFKA_CPU_LIMIT="2"
KAFKA_MEM_REQUEST="1536Mi"
KAFKA_MEM_LIMIT="2Gi"
KAFKA_STORAGE="30Gi"
# JVM heap - keep well below KAFKA_MEM_LIMIT (rest used by page cache).
KAFKA_HEAP_OPTS="-Xmx1G -Xms1G"
KAFKA_NUM_PARTITIONS="3"
KAFKA_LOG_RETENTION_HOURS="2"
# Start a new log segment at least this often (ms). Retention deletes only whole,
# closed segments, so without it a 1 GB segment can keep data far past the
# retention window on a quiet broker. 600000 = 10 min.
KAFKA_LOG_ROLL_MS="600000"
KAFKA_NUM_NETWORK_THREADS="3"
KAFKA_NUM_IO_THREADS="8"
KAFKA_SOCKET_SEND_BUFFER_BYTES="1048576"
KAFKA_SOCKET_RECEIVE_BUFFER_BYTES="1048576"
KAFKA_SOCKET_REQUEST_MAX_BYTES="104857600"

# ─── Logstash (ingest → Kafka) ────────────────────────────────────────────────
IMAGE_LOGSTASH="docker.elastic.co/logstash/logstash-oss:9.5.2"
LOGSTASH_REPLICAS=1
LOGSTASH_JAVA_OPTS="-Xms512m -Xmx512m"
LOGSTASH_CPU_REQUEST="250m"
LOGSTASH_CPU_LIMIT="1"
LOGSTASH_MEM_REQUEST="768Mi"
LOGSTASH_MEM_LIMIT="1Gi"
LOGSTASH_PIPELINE_WORKERS=2
LOGSTASH_PIPELINE_BATCH_SIZE=125
# Kafka the Logstash output writes to (in-cluster)
LOGSTASH_KAFKA_BOOTSTRAP="kafka:9092"
# Input listener ports (container) + NodePorts (host) for syslog / json / unstructured
LOGSTASH_SYSLOG_PORT=10501
LOGSTASH_JSON_PORT=10510
LOGSTASH_TEXT_PORT=10520
LOGSTASH_SYSLOG_NODEPORT=30501
LOGSTASH_JSON_NODEPORT=30510
LOGSTASH_TEXT_NODEPORT=30520
